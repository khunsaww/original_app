<%= form_with model: die, data: {
      controller: "die-form",
      action: "submit->die-form#confirmQuantity",
      die_form_original_new_quantity_value: die.new_quantity,
      die_form_original_used_quantity_value: die.used_quantity,
      die_form_persisted_value: die.persisted?
    } do |f| %>
  <% if die.errors.any? %>
    <div class="error-list">
      <ul>
        <% die.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div>
      <%= f.label :name %>
      <%= f.text_field :name, required: true %>
    </div>
    <div>
      <%= f.label :product_code %>
      <%= f.text_field :product_code, required: true %>
    </div>
    <div>
      <%= f.label :size %>
      <%= f.text_field :size %>
    </div>
    <div>
      <%= f.label :category %>
      <%= f.text_field :category, placeholder: "ヘッダーダイス など" %>
    </div>
    <div>
      <%= f.label :location_id %>
      <%= f.collection_select :location_id, @locations, :id, :name, prompt: "選択してください" %>
    </div>
    <div>
      <%= f.label :new_quantity %>
      <%= f.number_field :new_quantity, min: 0, step: 1, data: { die_form_target: "newQuantity", action: "input->die-form#updateTotal" } %>
    </div>
    <div>
      <%= f.label :used_quantity %>
      <%= f.number_field :used_quantity, min: 0, step: 1, data: { die_form_target: "usedQuantity", action: "input->die-form#updateTotal" } %>
    </div>
    <div>
      <%= f.label :unit_price %>
      <% if admin? %>
        <%= f.number_field :unit_price, min: 0, step: 1, data: { die_form_target: "unitPrice", action: "input->die-form#updateTotal" } %>
      <% else %>
        <p><strong><%= yen(die.unit_price) %></strong></p>
        <p class="muted">単価の変更は管理者のみです。</p>
        <%= f.hidden_field :unit_price, data: { die_form_target: "unitPrice" } %>
      <% end %>
    </div>
    <div>
      <label>合計金額（自動計算）</label>
      <p><strong>¥<span data-die-form-target="total">0</span></strong></p>
    </div>
    <div>
      <%= f.label :purchase_date %>
      <%= f.date_field :purchase_date %>
    </div>
  </div>
  <div>
    <%= f.label :notes %>
    <%= f.text_area :notes %>
  </div>
  <div class="form-actions">
    <%= f.submit class: "btn" %>
    <%= link_to "キャンセル", die.persisted? ? die : dies_path, class: "btn btn--secondary" %>
  </div>
<% end %>
