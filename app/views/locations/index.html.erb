<div class="page-head">
  <%= page_title "保管場所一覧" %>
  <% if admin? %>
    <%= link_to "新規登録", new_location_path, class: "btn" %>
  <% end %>
</div>

<div class="table-wrap">
<table class="data-table">
  <thead>
    <tr>
      <th>名称</th>
      <th>説明</th>
      <th class="num">ダイス件数</th>
    </tr>
  </thead>
  <tbody>
    <% @locations.each do |location| %>
      <tr>
        <td><%= link_to location.name, location %></td>
        <td><%= location.description %></td>
        <td class="num"><%= @die_counts[location.id].to_i %></td>
      </tr>
    <% end %>
    <% if @locations.empty? %>
      <tr><td colspan="3" class="muted">保管場所がありません。</td></tr>
    <% end %>
  </tbody>
</table>
</div>
